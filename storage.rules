rules_version = '2';

// Deploy with: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    // Profile pictures live under avatars/<userId>/...
    // Read: public (avatars render on public pages, e.g. /link/:username)
    // Write: only the authenticated owner of that user id
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}