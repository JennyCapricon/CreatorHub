# Firebase Configuration
# Get these from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Cloudinary Configuration (profile picture uploads)
# Cloud name is public. The upload preset must be an UNSIGNED preset created in
# Cloudinary Console -> Settings -> Upload -> Presets, restricted to:
#   - Folder: creator-hub/avatars (locked)
#   - Allowed formats: jpg, jpeg, png, webp
#   - Max file size: 5 MB (5 * 1024 * 1024)
# The Cloudinary API secret must NEVER go into the frontend.
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset_name
